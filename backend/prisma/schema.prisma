
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// -------------------------
// ENUMS
// -------------------------

enum EmployeeRole {
  HR
  HIRING_MANAGER
  INTERVIEWER
  APPROVER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  TECHNICAL
  MANAGERIAL
  HR
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  WITHDRAWN
  HIRED
}


enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BOOKED
}

enum InterviewType {
  TECHNICAL
  MANAGERIAL
  HR
  SCREENING
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum ParticipantRole {
  LEAD
  PANELIST
  OBSERVER
}

enum ScoreRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

// -------------------------
// EMPLOYEE
// -------------------------

model Employee {
  employeeId String       @id
  fullName   String
  email      String       @unique
  department String
  role       EmployeeRole
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  availabilities          Availability[]
  panelMemberships        PanelMember[]
  interviewParticipations InterviewParticipant[]
  scorecards              Scorecard[]

  hiringManagerProfile HiringManager?
}

// -------------------------
// HIRING MANAGER
// -------------------------

model HiringManager {
  hiringManagerId String   @id
  employeeId      String   @unique
  designation     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  requisitions Requisition[]
}

// -------------------------
// REQUISITION
// -------------------------

model Requisition {
  requisitionId  String            @id
  title          String
  department     String
  location       String
  employmentType EmploymentType
  minSalary      Decimal           @db.Decimal(12, 2)
  maxSalary      Decimal           @db.Decimal(12, 2)
  openings       Int
  hiringManagerId String
  status         RequisitionStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  skillRequirements SkillRequirement[]
  interviewPanels   InterviewPanel[]

  hiringManager HiringManager @relation(fields: [hiringManagerId], references: [hiringManagerId], onDelete: Restrict)
  applications  Application[]

  @@index([status])
  @@index([department])
}

// -------------------------
// CANDIDATE
// -------------------------

model Candidate {
  candidateId    String   @id
  fullName       String
  email          String   @unique
  phone          String?
  location       String?
  experienceYears Decimal @db.Decimal(4, 1)
  currentCompany String?
  resumeUrl      String?
  createdAt      DateTime @default(now())

  applications Application[]
}

// -------------------------
// APPLICATION
// -------------------------

model Application {
  applicationId String            @id
  candidateId   String
  requisitionId String
  currentStage  ApplicationStage  @default(APPLIED)
  status        ApplicationStatus @default(ACTIVE)
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  interviews Interview[]

  candidate   Candidate   @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  requisition Requisition @relation(fields: [requisitionId], references: [requisitionId], onDelete: Restrict)

  @@unique([candidateId, requisitionId])
  @@index([currentStage])
  @@index([status])
}


// -------------------------
// SKILL REQUIREMENTS
// -------------------------

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model SkillRequirement {
  skillRequirementId String     @id
  requisitionId      String
  skillName          String
  minimumLevel       SkillLevel
  isMandatory        Boolean    @default(true)
  weight             Decimal    @db.Decimal(5, 2)
  createdAt          DateTime   @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [requisitionId], onDelete: Restrict)

  @@index([requisitionId])
}

// -------------------------
// INTERVIEW PANEL
// -------------------------

model InterviewPanel {
  panelId       String   @id
  requisitionId String
  panelName     String
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [requisitionId], onDelete: Restrict)
  members     PanelMember[]
  interviews  Interview[]

  @@index([requisitionId])
}

// -------------------------
// PANEL MEMBERS
// -------------------------

model PanelMember {
  panelMemberId String   @id
  panelId       String
  employeeId    String
  assignedAt    DateTime @default(now())

  panel    InterviewPanel @relation(fields: [panelId], references: [panelId], onDelete: Restrict)
  employee Employee       @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  @@unique([panelId, employeeId])
}

// -------------------------
// INTERVIEWER AVAILABILITY
// -------------------------

model Availability {
  availabilityId String             @id
  interviewerId  String
  startTime      DateTime
  endTime        DateTime
  status         AvailabilityStatus @default(AVAILABLE)
  createdAt      DateTime           @default(now())

  interviewer Employee @relation(fields: [interviewerId], references: [employeeId], onDelete: Restrict)

  @@index([interviewerId, startTime, endTime])
}

// -------------------------
// INTERVIEW
// -------------------------

model Interview {
  interviewId  String          @id
  applicationId String
  panelId      String
  startTime    DateTime
  endTime      DateTime
  interviewType InterviewType
  status       InterviewStatus @default(SCHEDULED)
  meetingLink  String?
  createdAt    DateTime        @default(now())

  application  Application          @relation(fields: [applicationId], references: [applicationId], onDelete: Restrict)
  panel        InterviewPanel       @relation(fields: [panelId], references: [panelId], onDelete: Restrict)
  participants InterviewParticipant[]
  scorecards   Scorecard[]

  @@index([applicationId])
  @@index([panelId, startTime, endTime])
}

// -------------------------
// INTERVIEW PARTICIPANTS
// -------------------------

model InterviewParticipant {
  participantId String          @id
  interviewId   String
  employeeId    String
  role          ParticipantRole

  interview Interview @relation(fields: [interviewId], references: [interviewId], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  @@unique([interviewId, employeeId])
  @@index([employeeId])
}

// -------------------------
// SCORECARD
// -------------------------

model Scorecard {
  scorecardId         String              @id
  interviewId         String
  reviewerId          String
  technicalScore      Decimal             @db.Decimal(3, 2)
  communicationScore  Decimal             @db.Decimal(3, 2)
  problemSolvingScore Decimal             @db.Decimal(3, 2)
  recommendation      ScoreRecommendation
  comments            String?
  submittedAt         DateTime            @default(now())

  interview Interview @relation(fields: [interviewId], references: [interviewId], onDelete: Restrict)
  reviewer  Employee  @relation(fields: [reviewerId], references: [employeeId], onDelete: Restrict)

  @@unique([interviewId, reviewerId])
}
