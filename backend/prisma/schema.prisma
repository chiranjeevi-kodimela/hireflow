
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// -------------------------
// ENUMS
// -------------------------

enum EmployeeRole {
  HR
  HIRING_MANAGER
  INTERVIEWER
  APPROVER
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  TECHNICAL
  MANAGERIAL
  HR
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  WITHDRAWN
  HIRED
}


enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BOOKED
}

enum InterviewType {
  TECHNICAL
  MANAGERIAL
  HR
  SCREENING
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum ParticipantRole {
  LEAD
  PANELIST
  OBSERVER
}

enum ScoreRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ApprovalType {
  REQUISITION
  OFFER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------------------------
// EMPLOYEE
// -------------------------

model Employee {
  employeeId String       @id
  fullName   String
  email      String       @unique
  department String
  role       EmployeeRole
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  availabilities          Availability[]
  panelMemberships        PanelMember[]
  interviewParticipations InterviewParticipant[]
  scorecards              Scorecard[]
  approvals       Approval[]              @relation("ApprovalApprover")
  stageChanges    ApplicationStageEvent[] @relation("StageChangedBy")
  auditLogs       AuditLog[]               @relation("AuditActor")

  hiringManagerProfile HiringManager?
}

// -------------------------
// HIRING MANAGER
// -------------------------

model HiringManager {
  hiringManagerId String   @id
  employeeId      String   @unique
  designation     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)
  requisitions Requisition[]
}

// -------------------------
// REQUISITION
// -------------------------

model Requisition {
  requisitionId  String            @id
  title          String
  department     String
  location       String
  employmentType EmploymentType
  minSalary      Decimal           @db.Decimal(12, 2)
  maxSalary      Decimal           @db.Decimal(12, 2)
  openings       Int
  hiringManagerId String
  status         RequisitionStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  skillRequirements SkillRequirement[]
  interviewPanels   InterviewPanel[]
  evaluationCriteria EvaluationCriterion[]
  approvals          Approval[]

  hiringManager HiringManager @relation(fields: [hiringManagerId], references: [hiringManagerId], onDelete: Restrict)
  applications  Application[]

  @@index([status])
  @@index([department])
}

// -------------------------
// CANDIDATE
// -------------------------

model Candidate {
  candidateId    String   @id
  fullName       String
  email          String   @unique
  phone          String?
  location       String?
  experienceYears Decimal @db.Decimal(4, 1)
  currentCompany String?
  resumeUrl      String?
  createdAt      DateTime @default(now())

  applications Application[]
}

// -------------------------
// APPLICATION
// -------------------------

model Application {
  applicationId String            @id
  candidateId   String
  requisitionId String
  currentStage  ApplicationStage  @default(APPLIED)
  status        ApplicationStatus @default(ACTIVE)
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  interviews Interview[]
  offers      Offer[]
  stageEvents ApplicationStageEvent[]

  candidate   Candidate   @relation(fields: [candidateId], references: [candidateId], onDelete: Restrict)
  requisition Requisition @relation(fields: [requisitionId], references: [requisitionId], onDelete: Restrict)

  @@unique([candidateId, requisitionId])
  @@index([currentStage])
  @@index([status])
}


// -------------------------
// SKILL REQUIREMENTS
// -------------------------

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model SkillRequirement {
  skillRequirementId String     @id
  requisitionId      String
  skillName          String
  minimumLevel       SkillLevel
  isMandatory        Boolean    @default(true)
  weight             Decimal    @db.Decimal(5, 2)
  createdAt          DateTime   @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [requisitionId], onDelete: Restrict)

  @@index([requisitionId])
}

// -------------------------
// INTERVIEW PANEL
// -------------------------

model InterviewPanel {
  panelId       String   @id
  requisitionId String
  panelName     String
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [requisitionId], onDelete: Restrict)
  members     PanelMember[]
  interviews  Interview[]

  @@index([requisitionId])
}

// -------------------------
// PANEL MEMBERS
// -------------------------

model PanelMember {
  panelMemberId String   @id
  panelId       String
  employeeId    String
  assignedAt    DateTime @default(now())

  panel    InterviewPanel @relation(fields: [panelId], references: [panelId], onDelete: Restrict)
  employee Employee       @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  @@unique([panelId, employeeId])
}

// -------------------------
// INTERVIEWER AVAILABILITY
// -------------------------

model Availability {
  availabilityId String             @id
  interviewerId  String
  startTime      DateTime
  endTime        DateTime
  status         AvailabilityStatus @default(AVAILABLE)
  createdAt      DateTime           @default(now())

  interviewer Employee @relation(fields: [interviewerId], references: [employeeId], onDelete: Restrict)

  @@index([interviewerId, startTime, endTime])
}

// -------------------------
// INTERVIEW
// -------------------------

model Interview {
  interviewId  String          @id
  applicationId String
  panelId      String
  startTime    DateTime
  endTime      DateTime
  interviewType InterviewType
  status       InterviewStatus @default(SCHEDULED)
  meetingLink  String?
  createdAt    DateTime        @default(now())

  application  Application          @relation(fields: [applicationId], references: [applicationId], onDelete: Restrict)
  panel        InterviewPanel       @relation(fields: [panelId], references: [panelId], onDelete: Restrict)
  participants InterviewParticipant[]
  scorecards   Scorecard[]

  @@index([applicationId])
  @@index([panelId, startTime, endTime])
}

// -------------------------
// INTERVIEW PARTICIPANTS
// -------------------------

model InterviewParticipant {
  participantId String          @id
  interviewId   String
  employeeId    String
  role          ParticipantRole

  interview Interview @relation(fields: [interviewId], references: [interviewId], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Restrict)

  @@unique([interviewId, employeeId])
  @@index([employeeId])
}

// -------------------------
// SCORECARD
// -------------------------

model Scorecard {
  scorecardId         String              @id
  interviewId         String
  reviewerId          String
  technicalScore      Decimal             @db.Decimal(3, 2)
  communicationScore  Decimal             @db.Decimal(3, 2)
  problemSolvingScore Decimal             @db.Decimal(3, 2)
  recommendation      ScoreRecommendation
  comments            String?
  submittedAt         DateTime            @default(now())
  items ScorecardItem[]

  interview Interview @relation(fields: [interviewId], references: [interviewId], onDelete: Restrict)
  reviewer  Employee  @relation(fields: [reviewerId], references: [employeeId], onDelete: Restrict)

  @@unique([interviewId, reviewerId])
}
model EvaluationCriterion {
  criterionId  String   @id @default(cuid())
  requisitionId String
  name         String
  description  String?
  category     String
  weight       Decimal  @db.Decimal(5, 2)
  isRequired   Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  requisition Requisition     @relation(fields: [requisitionId], references: [requisitionId], onDelete: Cascade)
  scorecardItems ScorecardItem[]

  @@index([requisitionId])
}

model ScorecardItem {
  itemId      String  @id @default(cuid())
  scorecardId String
  criterionId String
  score       Decimal @db.Decimal(4, 2)
  comments    String?

  scorecard Scorecard           @relation(fields: [scorecardId], references: [scorecardId], onDelete: Cascade)
  criterion EvaluationCriterion @relation(fields: [criterionId], references: [criterionId])

  @@unique([scorecardId, criterionId])
}

model Offer {
  offerId       String      @id @default(cuid())
  applicationId String
  version       Int         @default(1)
  baseSalary    Decimal     @db.Decimal(12, 2)
  bonus         Decimal?    @db.Decimal(12, 2)
  currency      String      @default("INR")
  status        OfferStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  sentAt        DateTime?
  respondedAt   DateTime?

  application Application @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)
  approvals   Approval[]

  @@unique([applicationId, version])
  @@index([status])
}

model Approval {
  approvalId   String         @id @default(cuid())
  offerId      String?
  requisitionId String?
  approverId   String
  approvalType ApprovalType
  status       ApprovalStatus @default(PENDING)
  comments     String?
  requestedAt  DateTime       @default(now())
  decidedAt    DateTime?

  offer       Offer?       @relation(fields: [offerId], references: [offerId], onDelete: Cascade)
  requisition Requisition? @relation(fields: [requisitionId], references: [requisitionId], onDelete: Cascade)
  approver    Employee     @relation("ApprovalApprover", fields: [approverId], references: [employeeId])

  @@index([status])
  @@index([approverId])
}

model ApplicationStageEvent {
  eventId      String   @id @default(cuid())
  applicationId String
  fromStage    String?
  toStage      String
  changedById  String?
  reason       String?
  changedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)
  changedBy   Employee?   @relation("StageChangedBy", fields: [changedById], references: [employeeId])

  @@index([applicationId, changedAt])
}

model AuditLog {
  auditLogId String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor Employee? @relation("AuditActor", fields: [actorId], references: [employeeId])

  @@index([entityType, entityId])
  @@index([createdAt])
}